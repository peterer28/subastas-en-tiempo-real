# --- Servidor ---
PORT=3000
# Orígenes permitidos (separados por coma). En producción, la URL de Firebase Hosting / Vercel.
CORS_ORIGINS=http://localhost:4200,https://fir-signos-vitales.web.app

# --- PostgreSQL --- (Render, Neon, Supabase o local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subastas
# true si el proveedor exige SSL (Render/Neon/Supabase)
PGSSL=false

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h
# Secreto para generar alias anónimos de postores (no lo compartas con el frontend)
BIDDER_SECRET=otra-cadena-larga-y-aleatoria

# --- Firebase Admin ---
FIREBASE_DATABASE_URL=https://fir-signos-vitales-default-rtdb.firebaseio.com
# Nodo raíz donde vive todo lo de subastas (no toca tus datos de signos vitales)
RTDB_ROOT=subastas
# Cuenta de servicio: Consola Firebase > Configuración del proyecto > Cuentas de servicio >
# Generar nueva clave privada. Pega el JSON en base64 (base64 -w0 clave.json).
FIREBASE_SERVICE_ACCOUNT_BASE64=
